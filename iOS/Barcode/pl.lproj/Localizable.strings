"early_entry_label" = "Wcześniejsze Wejście";
"early_entry_text" = "**Wcześniejsze wejście** jest usługą dla osób w wieku 65 lat i starszych oraz osób mających trudności z długim staniem. Otrzymasz dostęp do spiżarni ***4 K.I.D.S. Sake*** 30 minut przed ogółem klientów.";
